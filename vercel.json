{
  "version": 2,
  "builds": [
    {
      "src": "api/index.go",
      "use": "@vercel/go"
    },
    {
      "src": "api/ping/index.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "^/api/ping$",
      "dest": "api/ping/index.go"
    },
    {
      "src": "^/(.*)$",
      "dest": "api/index.go?__cloak_path=/$1"
    }
  ]
}
