<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.title}}</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#333;background:#f5f5f5}
.topbar{background:#222;color:#eee;text-align:center;padding:10px;font-size:13px}
header{background:#fff;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 1px 3px rgba(0,0,0,.06)}
header .brand{font-size:24px;font-weight:700;color:{{if .accent_color}}{{.accent_color}}{{else}}#e65100{{end}}}
header nav a{color:#555;text-decoration:none;margin-left:20px;font-size:15px}
header nav a:hover{color:{{if .accent_color}}{{.accent_color}}{{else}}#e65100{{end}}}
.hero{background:#fff;padding:48px 24px;text-align:center;border-bottom:1px solid #eee}
.hero h1{font-size:32px;font-weight:700;margin-bottom:12px}
.hero p{color:#777;font-size:16px;max-width:600px;margin:0 auto;line-height:1.6}
.products{max-width:1080px;margin:40px auto;padding:0 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.products .item{background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.products .item .img{height:200px;background:linear-gradient(135deg,#e0e0e0,#f0f0f0);display:flex;align-items:center;justify-content:center;font-size:14px;color:#aaa}
.products .item .info{padding:20px}
.products .item .info .price{font-size:20px;font-weight:700;color:{{if .accent_color}}{{.accent_color}}{{else}}#e65100{{end}}}
.products .item .info .title{font-size:16px;margin:8px 0;font-weight:600}
.products .item .info .desc{color:#888;font-size:13px;line-height:1.5}
.products .item .info .buy{display:inline-block;margin-top:12px;background:{{if .accent_color}}{{.accent_color}}{{else}}#e65100{{end}};color:#fff;padding:8px 20px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600}
.trust{max-width:800px;margin:48px auto;padding:0 24px;text-align:center}
.trust h2{font-size:22px;margin-bottom:24px}
.trust .badges{display:flex;gap:40px;justify-content:center;color:#aaa;font-size:13px;flex-wrap:wrap}
footer{text-align:center;padding:32px 24px;color:#aaa;font-size:12px;background:#fff;border-top:1px solid #eee}
footer a{color:#aaa;text-decoration:none;margin:0 8px}
</style>
</head>
<body>
<div class="topbar">{{if .topbar_text}}{{.topbar_text}}{{else}}Free shipping on orders over $50{{end}}</div>
<header>
  <span class="brand">{{if .brand_name}}{{.brand_name}}{{else}}ShopName{{end}}</span>
  <nav>
    <a href="/">Shop</a>
    <a href="/">About</a>
    <a href="/">Blog</a>
    <a href="/">Contact</a>
  </nav>
</header>
<section class="hero">
  <h1>{{if .hero_title}}{{.hero_title}}{{else}}Quality Products for Everyday Life{{end}}</h1>
  <p>{{if .hero_desc}}{{.hero_desc}}{{else}}We curate the best products to make your daily routine simpler and more enjoyable.{{end}}</p>
</section>
<section class="products">
  {{range .products}}
  <div class="item">
    <div class="img">{{if .image}}{{.image}}{{else}}Product Image{{end}}</div>
    <div class="info">
      <span class="price">{{.price}}</span>
      <div class="title">{{.title}}</div>
      <p class="desc">{{.desc}}</p>
      <a href="/" class="buy">{{if $.cta_text}}{{$.cta_text}}{{else}}Add to Cart{{end}}</a>
    </div>
  </div>
  {{end}}
</section>
<section class="trust">
  <h2>{{if .trust_title}}{{.trust_title}}{{else}}Trusted By Thousands{{end}}</h2>
  <div class="badges">
    {{range .trust_badges}}<span>{{.}}</span>{{end}}
  </div>
</section>
<footer>
  <p>&copy; {{.year}} {{if .brand_name}}{{.brand_name}}{{else}}ShopName{{end}}. {{if .privacy_url}}<a href="{{.privacy_url}}">Privacy</a>{{end}}{{if .terms_url}}<a href="{{.terms_url}}">Terms</a>{{end}}{{if .returns_url}}<a href="{{.returns_url}}">Returns</a>{{end}}</p>
</footer>
</body>
</html>
