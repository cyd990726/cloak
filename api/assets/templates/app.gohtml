<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{.title}}</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#222;background:#f8f9fa}
header{background:#fff;padding:16px 24px;box-shadow:0 1px 4px rgba(0,0,0,.08);display:flex;align-items:center;justify-content:space-between}
header .logo{font-size:22px;font-weight:700;color:{{if .accent_color}}{{.accent_color}}{{else}}#1a73e8{{end}}}
header nav a{color:#555;text-decoration:none;margin-left:24px;font-size:15px}
.hero{text-align:center;padding:80px 24px 60px;background:linear-gradient(135deg,{{if .accent_color}}{{.accent_color}}{{else}}#1a73e8{{end}},{{if .accent_secondary}}{{.accent_secondary}}{{else}}#4285f4{{end}});color:#fff}
.hero h1{font-size:40px;font-weight:700;margin-bottom:16px}
.hero p{font-size:18px;opacity:.9;max-width:560px;margin:0 auto 32px;line-height:1.6}
.hero .cta{display:inline-flex;gap:16px;flex-wrap:wrap;justify-content:center}
.hero .btn{display:inline-block;padding:14px 32px;border-radius:8px;font-size:16px;font-weight:600;text-decoration:none;transition:transform .2s}
.hero .btn:hover{transform:scale(1.03)}
.btn-primary{background:#fff;color:{{if .accent_color}}{{.accent_color}}{{else}}#1a73e8{{end}}}
.btn-outline{background:transparent;border:2px solid rgba(255,255,255,.6);color:#fff}
.features{max-width:960px;margin:60px auto;padding:0 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:32px}
.features .card{background:#fff;border-radius:12px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-align:center}
.features .card .icon{font-size:36px;margin-bottom:16px}
.features .card h3{font-size:18px;margin-bottom:8px}
.features .card p{color:#666;font-size:14px;line-height:1.6}
.download{background:#fff;padding:60px 24px;text-align:center}
.download h2{font-size:28px;margin-bottom:32px}
.download .stores{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.download .store-btn{display:inline-block;background:#000;color:#fff;padding:12px 28px;border-radius:8px;text-decoration:none;font-weight:600;font-size:15px}
footer{text-align:center;padding:32px 24px;color:#999;font-size:13px}
footer a{color:#999;text-decoration:none}
</style>
</head>
<body>
<header>
  <span class="logo">{{if .brand_name}}{{.brand_name}}{{else}}AppName{{end}}</span>
  <nav>
    <a href="/">Features</a>
    <a href="/">Pricing</a>
    <a href="/">Support</a>
  </nav>
</header>
<section class="hero">
  <h1>{{if .hero_title}}{{.hero_title}}{{else}}Your Daily Companion App{{end}}</h1>
  <p>{{if .hero_desc}}{{.hero_desc}}{{else}}Discover a smarter way to manage your daily tasks. Simple, fast, and designed for everyone.{{end}}</p>
  <div class="cta">
    {{if .app_store_url}}<a href="{{.app_store_url}}" class="btn btn-primary">Download for Free</a>{{end}}
    <a href="/" class="btn btn-outline">Learn More</a>
  </div>
</section>
<section class="features">
  {{range .features}}
  <div class="card">
    <div class="icon">{{.icon}}</div>
    <h3>{{.title}}</h3>
    <p>{{.desc}}</p>
  </div>
  {{end}}
</section>
<section class="download">
  <h2>{{if .download_title}}{{.download_title}}{{else}}Available on All Platforms{{end}}</h2>
  <div class="stores">
    {{if .app_store_url}}<a href="{{.app_store_url}}" class="store-btn">App Store</a>{{end}}
    {{if .google_play_url}}<a href="{{.google_play_url}}" class="store-btn">Google Play</a>{{end}}
  </div>
</section>
<footer>
  <p>&copy; {{.year}} {{if .brand_name}}{{.brand_name}}{{else}}AppName{{end}}. {{if .privacy_url}}<a href="{{.privacy_url}}">Privacy Policy</a> &middot; {{end}}{{if .terms_url}}<a href="{{.terms_url}}">Terms of Service</a>{{end}}</p>
</footer>
</body>
</html>
